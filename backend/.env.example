# ==============================================================================
# Foundation Environment Variables
# ==============================================================================
NODE_ENV=development
PORT=5000

# MongoDB connection string (legacy MONGO_URI is also supported if already present)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Isolated MongoDB database URI used only by integration tests (must NOT point to app DB)
MONGODB_TEST_URI=mongodb+srv://<test_user>:<test_password>@<cluster>.mongodb.net/code2create_test?retryWrites=true&w=majority

# Optional DNS resolver settings for Windows SRV lookup quirks (fallback disabled by default in production)
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
# MONGODB_DNS_FALLBACK=false

# Explicit CORS frontend origin allowlist (required in production)
PARTICIPANT_FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174

# Structured logging level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Logging output format: minimal (dev default) | debug | json (production default)
LOG_FORMAT=minimal

# ==============================================================================
# Phase 02 Authentication & Session Variables
# ==============================================================================
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Must be at least 32 characters of high-entropy randomness
SESSION_SECRET=<replace-with-at-least-32-character-random-secret>

# 8 hours absolute lifetime (28800000 ms), 2 hours idle timeout (7200000 ms)
SESSION_MAX_AGE_MS=28800000
SESSION_IDLE_TIMEOUT_MS=7200000

# OAuth transaction state lifetime (10 minutes = 600000 ms)
OAUTH_STATE_TTL_MS=600000

# ==============================================================================
# Phase 06 Judge0 Execution Variables
# ==============================================================================
# Development uses local GCP IAP SSH tunnel: http://127.0.0.1:2358
# Production must use private backend-to-Judge0 network connectivity (never local tunnel)
JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_AUTH_TOKEN=<replace-with-judge0-auth-token>
JUDGE0_MAX_IN_FLIGHT=8
JUDGE0_REQUEST_TIMEOUT_MS=10000
JUDGE0_POLL_INTERVAL_MS=750
JUDGE0_POLL_TIMEOUT_MS=60000

# ==============================================================================
# Phase 07 Persistent Execution Queue & Worker Configuration
# ==============================================================================
# Worker starts automatically in development/production when true; defaults false in test
EXECUTION_WORKER_ENABLED=true
EXECUTION_WORKER_POLL_INTERVAL_MS=250
EXECUTION_LEASE_DURATION_MS=30000
EXECUTION_LEASE_RENEW_INTERVAL_MS=10000
EXECUTION_MAX_QUEUED_SUBMISSIONS=100
EXECUTION_RETRY_MAX_ATTEMPTS=3
EXECUTION_SHUTDOWN_TIMEOUT_MS=8000
EXECUTION_UNCERTAIN_RECONCILE_MS=90000
